# Settings for the API (apps/api). The API reads real environment variables;
# this file is applied by `uv run --env-file .env ...` (scripts/start.sh does
# that for you). Blank values mean "not set".

DATABASE_URL=postgresql+psycopg://slate:slate@localhost:5432/slate
SESSION_COOKIE=slate_session
SESSION_DAYS=30
# Set to true behind HTTPS.
COOKIE_SECURE=false
# "process" grades each answer in a child process that is killed after
# GRADING_TIMEOUT_S; "inline" is for tests and debugging only.
SANDBOX=process
GRADING_TIMEOUT_S=4
WORKSHEET_SIZE=6

# Object storage for uploads and cached lesson audio. Leave S3_BUCKET empty to
# store files on local disk under STORAGE_DIR.
STORAGE_DIR=var/storage
# To use the MinIO from docker-compose instead: `docker compose up -d minio`,
# create a bucket named slate at http://localhost:9001 (login slate/slateslate),
# then set S3_BUCKET=slate, S3_ENDPOINT_URL=http://localhost:9000,
# AWS_ACCESS_KEY_ID=slate and AWS_SECRET_ACCESS_KEY=slateslate.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Claude API: lesson scripts, hints, "where to look" notes, questions, OCR.
# Without a key Slate falls back to the templated text in the skills package.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Narrated voice for lessons. Set either key. TTS_PROVIDER picks one when both
# are set: elevenlabs | openai | silent (a silent test voice, no key needed).
# ElevenLabs returns character timings directly; OpenAI audio is aligned with
# word timestamps from transcription.
TTS_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Voices offered in the player, as Name:voice_id pairs separated by commas, e.g.
# "Rachel:21m00Tcm4TlvDq8ikWAM,Adam:pNInz6obpgDQGcFmaJgB". Blank uses the defaults.
# Put quotes around any value that contains a space.
ELEVENLABS_VOICES=
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Spoken questions in the lesson's ask panel. Empty picks OpenAI when its key
# is set, otherwise ElevenLabs; "fake" returns a fixed question (for tests).
STT_PROVIDER=
OPENAI_STT_MODEL=whisper-1
ELEVENLABS_STT_MODEL=scribe_v1

# The web app (apps/web) forwards /api requests to http://localhost:8000.
# Next.js does not read this file: if your API runs elsewhere, put
# API_ORIGIN=http://localhost:<port> in apps/web/.env.local or export it.
